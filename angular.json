{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "standalone": true,
      "changeDetection": "OnPush"
    }
  },
  "projects": {
    "english-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [],
            "styles": [
              "src/styles.scss"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "game-data/word-gap-duel/**"
                ]
              }
            ],
            "outputPath": "dist/english-app",
            "baseHref": "/English-app-demo/"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "english-app:build:development"
            },
            "production": {
              "buildTarget": "english-app:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
